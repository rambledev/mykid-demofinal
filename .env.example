# Local development only — copy to .env and fill in (never commit .env). Production: set these in Coolify.
# This file holds placeholders only — never real hosts, passwords or keys.
MYKID_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mykid
DB_USER=mykid
DB_PASS=change-me

# Secrets / switches
# APP_KEY: id tokens — generate your own (openssl rand -base64 48); the app refuses to run while it is empty
APP_KEY=
# MEDIA_TOKEN_SECRET: signs CCTV stream tokens checked by MediaMTX (/api/media-auth). Separate from APP_KEY,
# at least 32 characters (openssl rand -base64 48). Empty / short / equal to APP_KEY = CCTV streams disabled.
MEDIA_TOKEN_SECRET=
# CCTV_VIEWERS_ENABLED=1 only after MediaMTX authentication is verified: until then teachers and parents
# get no stream URL (admin / executive can still test).
CCTV_VIEWERS_ENABLED=0
