# Copy to .env for local development (never commit .env). In Coolify set these as env vars instead.
MYKID_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mykid
DB_USER=mykid
DB_PASS=change-me

# 32+ random characters — signs/encrypts the ID tokens in URLs (generate: openssl rand -base64 48)
APP_KEY=
# 1 = role cards on the home page log straight into the demo accounts + test accounts on the login page.
# Set to 0 for real use.
DEMO_MODE=0
